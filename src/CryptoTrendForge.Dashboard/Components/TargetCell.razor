<div class="font-monospace small">@PriceText</div>
@if (Minutes is not null)
{
    <span class="badge text-bg-success">@Minutes min</span>
}
else if (ClosedAt is null)
{
    <span class="badge text-bg-warning">watching</span>
}
else
{
    <span class="badge text-bg-secondary">not reached</span>
}

@code {
    [Parameter] public decimal? Price { get; set; }
    [Parameter] public int? Minutes { get; set; }
    [Parameter] public DateTimeOffset? ClosedAt { get; set; }

    private string PriceText => Price?.ToString("0.########") ?? "—";
}
