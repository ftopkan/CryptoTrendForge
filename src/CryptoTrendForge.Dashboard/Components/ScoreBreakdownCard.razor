<div class="card border-secondary-subtle h-100">
    <div class="card-header">Skor dağılımı</div>
    <div class="card-body">
        @if (Breakdown.Count == 0)
        {
            <p class="text-secondary mb-0">Skor dağılımı yok.</p>
        }
        else
        {
            @foreach (var item in Ordered())
            {
                var max = MaxFor(item.Key);
                var percent = max == 0 ? 0m : Math.Clamp(item.Value * 100m / max, -100m, 100m);
                <RateBar Label="@DisplayText.Breakdown(item.Key)" Percent="@percent" Negative="@(item.Value < 0)" Value="@($"{item.Value}/{max}")" />
            }
        }
    </div>
</div>

@code {
    private static readonly string[] ScoreOrder = ["trend", "rsi", "volume", "support", "oi", "btc_rs", "pattern_bonus"];

    [Parameter] public Dictionary<string, int> Breakdown { get; set; } = new();
    [Parameter] public bool IsStock { get; set; }

    private IEnumerable<KeyValuePair<string, int>> Ordered()
    {
        return Breakdown
            .OrderBy(item =>
            {
                var index = Array.IndexOf(ScoreOrder, item.Key);
                return index < 0 ? ScoreOrder.Length : index;
            });
    }

    private int MaxFor(string key)
    {
        return key switch
        {
            "trend" => 25,
            "rsi" or "volume" => 20,
            "support" => IsStock ? 30 : 20,
            "oi" => 10,
            "btc_rs" => 10,
            "pattern_bonus" => 10,
            _ => Math.Max(1, 25)
        };
    }
}
