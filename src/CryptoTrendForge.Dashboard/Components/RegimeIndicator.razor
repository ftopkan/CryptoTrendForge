@if (Regime == MarketRegime.RiskOn)
{
    <span style="color: #0d8a2a;">RISK_ON</span>
}
else if (Regime == MarketRegime.RiskOff)
{
    <span style="color: #b00020;">RISK_OFF</span>
}
else
{
    <span style="color: #9a6b00;">NEUTRAL</span>
}

@code {
    [Parameter] public MarketRegime Regime { get; set; }
}
