@if (Regime == MarketRegime.RiskOn)
{
    <span class="badge text-bg-success">Risk on</span>
}
else if (Regime == MarketRegime.RiskOff)
{
    <span class="badge text-bg-danger">Risk off</span>
}
else
{
    <span class="badge text-bg-warning">Neutral</span>
}

@code {
    [Parameter] public MarketRegime Regime { get; set; }
}
