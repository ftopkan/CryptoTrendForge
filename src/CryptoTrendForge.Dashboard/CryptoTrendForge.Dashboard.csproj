<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Ensure static files exist on disk for IIS/Plesk (not only SWA manifest). -->
    <CopyStaticWebAssetsToOutputDirectory>true</CopyStaticWebAssetsToOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="appsettings.Production.local.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('appsettings.Production.local.json')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.10" />
    <ProjectReference Include="../CryptoTrendForge.Core/CryptoTrendForge.Core.csproj" />
    <ProjectReference Include="../CryptoTrendForge.Core.Migrations.Postgres/CryptoTrendForge.Core.Migrations.Postgres.csproj" />
    <ProjectReference Include="../CryptoTrendForge.Core.Migrations.SqlServer/CryptoTrendForge.Core.Migrations.SqlServer.csproj" />
  </ItemGroup>
</Project>
