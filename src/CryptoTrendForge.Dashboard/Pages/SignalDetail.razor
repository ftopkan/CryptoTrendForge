@page "/signals/{SignalId:int}"
@inject DashboardDataService DataService
@inject DashboardSession Session

@if (!Session.IsAuthenticated)
{
    <div class="alert alert-secondary">Önce giriş yap. <a href="/login">Giriş</a></div>
}
else if (detail is null)
{
    <div class="alert alert-warning">Sinyal bulunamadı.</div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">@detail.Symbol <span class="badge text-bg-secondary">@(detail.CoinType == CoinType.Stock ? "Hisse" : "Kripto")</span> <span class="text-secondary">#@detail.Id</span></h1>
        <a class="btn btn-outline-secondary btn-sm" href="/signals">Listeye dön</a>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-4">
            <div class="card border-secondary-subtle h-100">
                <div class="card-header">Sinyal</div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between"><span>Tür</span><span>@DisplayText.LongKind(detail.SignalType)</span></li>
                    <li class="list-group-item d-flex justify-content-between"><span>Durum</span><span class="badge @DisplayText.StatusBadge(detail.Status)">@DisplayText.Status(detail.Status)</span></li>
                    @if (detail.CoinType == CoinType.Stock)
                    {
                        <li class="list-group-item d-flex justify-content-between"><span>Piyasa</span><span>NYSE</span></li>
                    }
                    else
                    {
                        <li class="list-group-item d-flex justify-content-between"><span>Rejim</span><RegimeIndicator Regime="@detail.Regime" /></li>
                    }
                    <li class="list-group-item d-flex justify-content-between"><span>Toplam</span><span class="fw-semibold">@detail.TotalScore</span></li>
                    <li class="list-group-item d-flex justify-content-between"><span>Temel / mum</span><span>@detail.BaseScore / @detail.PatternBonus</span></li>
                    <li class="list-group-item d-flex justify-content-between"><span>Destek</span><span class="font-monospace">@detail.SupportLevel</span></li>
                    <li class="list-group-item d-flex justify-content-between"><span>Uzaklık</span><span>@detail.SupportDistPct%</span></li>
                    <li class="list-group-item d-flex justify-content-between"><span>Funding</span><span>@detail.FundingRate</span></li>
                </ul>
            </div>
        </div>
        <div class="col-lg-8">
            <ScoreBreakdownCard Breakdown="@detail.Breakdown" />
        </div>
    </div>

    @if (detail.EntryPrice is not null)
    {
        <div class="card border-secondary-subtle mb-3">
            <div class="card-header">Çıkış planı</div>
            <div class="table-responsive">
                <table class="table align-middle mb-0 data-table">
                    <thead>
                        <tr><th>Seviye</th><th>Fiyat</th><th>Sonuç</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>Giriş</td><td class="num font-monospace">@FormatPrice(detail.EntryPrice)</td><td></td></tr>
                        <tr><td>Stop</td><td class="num font-monospace">@FormatPrice(detail.StopPrice)</td><td><TargetCell BadgeOnly="true" Minutes="@detail.StopMinutes" ClosedAt="@detail.TargetsClosedAt" /></td></tr>
                        <tr><td>Temkinli</td><td class="num font-monospace">@FormatPrice(detail.CautiousExit)</td><td><TargetCell BadgeOnly="true" Minutes="@detail.CautiousMinutes" ClosedAt="@detail.TargetsClosedAt" /></td></tr>
                        <tr><td>Dengeli</td><td class="num font-monospace">@FormatPrice(detail.BalancedExit)</td><td><TargetCell BadgeOnly="true" Minutes="@detail.BalancedMinutes" ClosedAt="@detail.TargetsClosedAt" /></td></tr>
                        <tr><td>Geniş</td><td class="num font-monospace">@FormatPrice(detail.WideExit)</td><td><TargetCell BadgeOnly="true" Minutes="@detail.WideMinutes" ClosedAt="@detail.TargetsClosedAt" /></td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="mb-3">
        <OutcomeChart Outcomes="@detail.Outcomes" />
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card border-secondary-subtle h-100">
                <div class="card-header">Gerekçeler</div>
                <ul class="list-group list-group-flush">
                    @foreach (var reason in detail.Reasons)
                    {
                        <li class="list-group-item">@reason</li>
                    }
                </ul>
            </div>
        </div>
        @if (detail.Risks.Count > 0)
        {
            <div class="col-md-6">
                <div class="card border-secondary-subtle h-100">
                    <div class="card-header">Riskler</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var risk in detail.Risks)
                        {
                            <li class="list-group-item">@risk</li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public int SignalId { get; set; }

    private SignalDetailView? detail;

    protected override async Task OnParametersSetAsync()
    {
        if (!Session.IsAuthenticated)
        {
            return;
        }

        detail = await DataService.GetSignalDetailAsync(SignalId);
    }

    private static string FormatPrice(decimal? value)
    {
        return value?.ToString("0.########") ?? "—";
    }
}
