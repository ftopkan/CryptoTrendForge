@page "/signals/{SignalId:int}"
@inject DashboardDataService DataService
@inject DashboardSession Session

@if (!Session.IsAuthenticated)
{
    <div class="alert alert-secondary">You must log in first. <a href="/login">Go to login</a></div>
}
else if (detail is null)
{
    <div class="alert alert-warning">Signal not found.</div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">@detail.Symbol <span class="badge text-bg-secondary">@(detail.CoinType == CoinType.Stock ? "Hisse" : "Kripto")</span> <span class="text-secondary">#@detail.Id</span></h1>
        <a class="btn btn-outline-secondary btn-sm" href="/signals">Back</a>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-4">
            <div class="card border-secondary-subtle h-100">
                <div class="card-header">Signal</div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between"><span>Type</span><span>@detail.SignalType</span></li>
                    <li class="list-group-item d-flex justify-content-between"><span>Status</span><span class="badge text-bg-dark">@detail.Status</span></li>
                    @if (detail.CoinType == CoinType.Stock)
                    {
                        <li class="list-group-item d-flex justify-content-between"><span>Market</span><span>NYSE</span></li>
                    }
                    else
                    {
                        <li class="list-group-item d-flex justify-content-between"><span>Regime</span><RegimeIndicator Regime="@detail.Regime" /></li>
                    }
                    <li class="list-group-item d-flex justify-content-between"><span>Total</span><span>@detail.TotalScore</span></li>
                    <li class="list-group-item d-flex justify-content-between"><span>Base / pattern</span><span>@detail.BaseScore / @detail.PatternBonus</span></li>
                    <li class="list-group-item d-flex justify-content-between"><span>Support</span><span class="font-monospace">@detail.SupportLevel</span></li>
                    <li class="list-group-item d-flex justify-content-between"><span>Distance</span><span>@detail.SupportDistPct%</span></li>
                    <li class="list-group-item d-flex justify-content-between"><span>Funding</span><span>@detail.FundingRate</span></li>
                </ul>
            </div>
        </div>
        <div class="col-lg-8">
            <ScoreBreakdownCard Breakdown="@detail.Breakdown" />
        </div>
    </div>

    @if (detail.EntryPrice is not null)
    {
        <div class="card border-secondary-subtle mb-3">
            <div class="card-header">Exit targets</div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr><th>Level</th><th>Price</th><th>Result</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>Entry</td><td class="font-monospace">@detail.EntryPrice</td><td></td></tr>
                        <tr><td>Stop</td><td colspan="2"><TargetCell Price="@detail.StopPrice" Minutes="@detail.StopMinutes" ClosedAt="@detail.TargetsClosedAt" /></td></tr>
                        <tr><td>Cautious</td><td colspan="2"><TargetCell Price="@detail.CautiousExit" Minutes="@detail.CautiousMinutes" ClosedAt="@detail.TargetsClosedAt" /></td></tr>
                        <tr><td>Balanced</td><td colspan="2"><TargetCell Price="@detail.BalancedExit" Minutes="@detail.BalancedMinutes" ClosedAt="@detail.TargetsClosedAt" /></td></tr>
                        <tr><td>Wide</td><td colspan="2"><TargetCell Price="@detail.WideExit" Minutes="@detail.WideMinutes" ClosedAt="@detail.TargetsClosedAt" /></td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="mb-3">
        <OutcomeChart Outcomes="@detail.Outcomes" />
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card border-secondary-subtle h-100">
                <div class="card-header">Reasons</div>
                <ul class="list-group list-group-flush">
                    @foreach (var reason in detail.Reasons)
                    {
                        <li class="list-group-item">@reason</li>
                    }
                </ul>
            </div>
        </div>
        @if (detail.Risks.Count > 0)
        {
            <div class="col-md-6">
                <div class="card border-secondary-subtle h-100">
                    <div class="card-header">Risks</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var risk in detail.Risks)
                        {
                            <li class="list-group-item">@risk</li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public int SignalId { get; set; }

    private SignalDetailView? detail;

    protected override async Task OnParametersSetAsync()
    {
        if (!Session.IsAuthenticated)
        {
            return;
        }

        detail = await DataService.GetSignalDetailAsync(SignalId);
    }
}
