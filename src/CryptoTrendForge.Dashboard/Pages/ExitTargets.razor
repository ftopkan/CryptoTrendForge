@page "/exits"
@inject DashboardDataService DataService
@inject DashboardSession Session

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Exit targets</h1>
</div>

@if (!Session.IsAuthenticated)
{
    <div class="alert alert-secondary">You must log in first. <a href="/login">Go to login</a></div>
}
else
{
    <div class="card border-secondary-subtle mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">From</label>
                    <input class="form-control" type="date" @bind="fromDate" @bind:format="yyyy-MM-dd" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">To</label>
                    <input class="form-control" type="date" @bind="toDate" @bind:format="yyyy-MM-dd" />
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary" @onclick="Load">Filter</button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-3">
            <div class="card border-secondary-subtle h-100"><div class="card-body"><div class="text-secondary small">Signals</div><div class="stat-value">@rows.Count</div></div></div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-secondary-subtle h-100"><div class="card-body"><div class="text-secondary small">Closed plans</div><div class="stat-value">@closedCount</div></div></div>
        </div>
        <div class="col-lg-6">
            <div class="card border-secondary-subtle h-100">
                <div class="card-body">
                    <RateBar Label="Cautious" Percent="@cautiousRate" Value="@($"{cautiousRate}%")" />
                    <RateBar Label="Balanced" Percent="@balancedRate" Value="@($"{balancedRate}%")" />
                    <RateBar Label="Wide" Percent="@wideRate" Value="@($"{wideRate}%")" />
                </div>
            </div>
        </div>
    </div>

    <div class="card border-secondary-subtle">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Time (UTC)</th>
                        <th>Symbol</th>
                        <th>Entry</th>
                        <th>Stop</th>
                        <th>Cautious</th>
                        <th>Balanced</th>
                        <th>Wide</th>
                    </tr>
                </thead>
                <tbody>
                    @if (rows.Count == 0)
                    {
                        <tr><td colspan="7" class="text-secondary">No signals with an exit plan in this date range.</td></tr>
                    }
                    @foreach (var row in rows)
                    {
                        <tr>
                            <td class="text-nowrap">@row.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><a class="fw-semibold" href="/signals/@row.Id">@row.Symbol</a></td>
                            <td class="font-monospace">@FormatPrice(row.EntryPrice)</td>
                            <td class="font-monospace">@FormatPrice(row.StopPrice)</td>
                            <td><TargetCell Price="@row.CautiousExit" Minutes="@row.CautiousMinutes" ClosedAt="@row.TargetsClosedAt" /></td>
                            <td><TargetCell Price="@row.BalancedExit" Minutes="@row.BalancedMinutes" ClosedAt="@row.TargetsClosedAt" /></td>
                            <td><TargetCell Price="@row.WideExit" Minutes="@row.WideMinutes" ClosedAt="@row.TargetsClosedAt" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private DateTime? fromDate;
    private DateTime? toDate;
    private IReadOnlyList<ExitTargetRow> rows = [];

    private int closedCount => rows.Count(x => x.TargetsClosedAt is not null);
    private decimal cautiousRate => HitRate(rows.Count(x => x.TargetsClosedAt is not null && x.CautiousMinutes is not null));
    private decimal balancedRate => HitRate(rows.Count(x => x.TargetsClosedAt is not null && x.BalancedMinutes is not null));
    private decimal wideRate => HitRate(rows.Count(x => x.TargetsClosedAt is not null && x.WideMinutes is not null));

    protected override async Task OnInitializedAsync()
    {
        if (Session.IsAuthenticated)
        {
            await Load();
        }
    }

    private async Task Load()
    {
        rows = await DataService.GetExitTargetsAsync(ToUtcStart(fromDate), ToUtcEnd(toDate));
    }

    private decimal HitRate(int hits)
    {
        if (closedCount == 0)
        {
            return 0m;
        }

        return Math.Round((decimal)hits * 100m / closedCount, 2);
    }

    private static DateTimeOffset? ToUtcStart(DateTime? date)
    {
        if (!date.HasValue)
        {
            return null;
        }

        return new DateTimeOffset(DateTime.SpecifyKind(date.Value.Date, DateTimeKind.Utc));
    }

    private static DateTimeOffset? ToUtcEnd(DateTime? date)
    {
        if (!date.HasValue)
        {
            return null;
        }

        return new DateTimeOffset(DateTime.SpecifyKind(date.Value.Date.AddDays(1).AddTicks(-1), DateTimeKind.Utc));
    }

    private static string FormatPrice(decimal? value)
    {
        return value?.ToString("0.########") ?? "—";
    }
}
