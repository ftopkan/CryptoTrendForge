@page "/exits"
@inject DashboardDataService DataService
@inject DashboardSession Session

<h3>Exit Targets</h3>

@if (!Session.IsAuthenticated)
{
    <p>You must log in first.</p>
    <a href="/login">Go to Login</a>
}
else
{
    <div class="filter-bar">
        <label>
            From
            <input type="date" @bind="fromDate" @bind:format="yyyy-MM-dd" />
        </label>
        <label>
            To
            <input type="date" @bind="toDate" @bind:format="yyyy-MM-dd" />
        </label>
        <button @onclick="Load">Filter</button>
    </div>

    <p><b>Signals:</b> @rows.Count</p>
    <p><b>Closed plans:</b> @closedCount</p>
    <p><b>Cautious hit rate:</b> %@cautiousRate</p>
    <p><b>Balanced hit rate:</b> %@balancedRate</p>
    <p><b>Wide hit rate:</b> %@wideRate</p>

    @if (rows.Count == 0)
    {
        <p>No signals with an exit plan in this date range.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Time (UTC)</th>
                    <th>Symbol</th>
                    <th>Entry</th>
                    <th>Stop</th>
                    <th>Cautious</th>
                    <th>Balanced</th>
                    <th>Wide</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    <tr>
                        <td>@row.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><a href="/signals/@row.Id">@row.Symbol</a></td>
                        <td>@FormatPrice(row.EntryPrice)</td>
                        <td>@FormatPrice(row.StopPrice)</td>
                        <td>@FormatTarget(row.CautiousExit, row.CautiousMinutes, row.TargetsClosedAt)</td>
                        <td>@FormatTarget(row.BalancedExit, row.BalancedMinutes, row.TargetsClosedAt)</td>
                        <td>@FormatTarget(row.WideExit, row.WideMinutes, row.TargetsClosedAt)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private DateTime? fromDate;
    private DateTime? toDate;
    private IReadOnlyList<ExitTargetRow> rows = [];

    private int closedCount => rows.Count(x => x.TargetsClosedAt is not null);
    private decimal cautiousRate => HitRate(rows.Count(x => x.TargetsClosedAt is not null && x.CautiousMinutes is not null));
    private decimal balancedRate => HitRate(rows.Count(x => x.TargetsClosedAt is not null && x.BalancedMinutes is not null));
    private decimal wideRate => HitRate(rows.Count(x => x.TargetsClosedAt is not null && x.WideMinutes is not null));

    protected override async Task OnInitializedAsync()
    {
        if (Session.IsAuthenticated)
        {
            await Load();
        }
    }

    private async Task Load()
    {
        rows = await DataService.GetExitTargetsAsync(ToUtcStart(fromDate), ToUtcEnd(toDate));
    }

    private decimal HitRate(int hits)
    {
        if (closedCount == 0)
        {
            return 0m;
        }

        return Math.Round((decimal)hits * 100m / closedCount, 2);
    }

    private static DateTimeOffset? ToUtcStart(DateTime? date)
    {
        if (!date.HasValue)
        {
            return null;
        }

        return new DateTimeOffset(DateTime.SpecifyKind(date.Value.Date, DateTimeKind.Utc));
    }

    private static DateTimeOffset? ToUtcEnd(DateTime? date)
    {
        if (!date.HasValue)
        {
            return null;
        }

        return new DateTimeOffset(DateTime.SpecifyKind(date.Value.Date.AddDays(1).AddTicks(-1), DateTimeKind.Utc));
    }

    private static string FormatPrice(decimal? value)
    {
        return value?.ToString("0.########") ?? "—";
    }

    private static string FormatTarget(decimal? price, int? minutes, DateTimeOffset? closedAt)
    {
        var level = FormatPrice(price);
        if (minutes is not null)
        {
            return $"{level} · {minutes} min";
        }

        return closedAt is null ? $"{level} · watching" : $"{level} · not reached";
    }
}
