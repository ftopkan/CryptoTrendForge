@page "/exits"
@using CryptoTrendForge.Core.Domain
@inject DashboardDataService DataService
@inject DashboardSession Session

<div class="mb-3">
    <h1 class="h3 mb-0">Çıkışlar</h1>
    <p class="page-lead text-secondary mb-0">Hedefe varan ve varmayan planların puan kalemleri. Saat Türkiye saatidir.</p>
</div>

@if (!Session.IsAuthenticated)
{
    <div class="alert alert-secondary">Önce giriş yap. <a href="/login">Giriş</a></div>
}
else
{
    <div class="card border-secondary-subtle mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Başlangıç</label>
                    <input class="form-control" type="date" @bind="fromDate" @bind:format="yyyy-MM-dd" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Bitiş</label>
                    <input class="form-control" type="date" @bind="toDate" @bind:format="yyyy-MM-dd" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Sonuç</label>
                    <select class="form-select" @bind="resultFilter">
                        <option value="all">Tümü</option>
                        <option value="hit">Temkinli hedefi tutan</option>
                        <option value="miss">Temkinli hedefi tutmayan</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary" @onclick="Load">Uygula</button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-3">
            <div class="card border-secondary-subtle h-100"><div class="card-body"><div class="text-secondary small">Sinyal</div><div class="stat-value">@rows.Count</div></div></div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-secondary-subtle h-100"><div class="card-body"><div class="text-secondary small">Kapanan plan</div><div class="stat-value">@closedCount</div></div></div>
        </div>
        <div class="col-lg-6">
            <div class="card border-secondary-subtle h-100">
                <div class="card-body">
                    <RateBar Label="Temkinli" Percent="@cautiousRate" Value="@($"{cautiousRate}%")" />
                    <RateBar Label="Dengeli" Percent="@balancedRate" Value="@($"{balancedRate}%")" />
                    <RateBar Label="Geniş" Percent="@wideRate" Value="@($"{wideRate}%")" />
                    <p class="text-secondary small mb-0 mt-2">Bitcoin bozduğu için kapanan: @btcBrokenCount. Bu planlar başarı oranının dışında.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        @foreach (var group in ScoreComparisons())
        {
            <div class="col-lg-6">
                <div class="card border-secondary-subtle h-100">
                    <div class="card-header">@group.Title · tutan @group.Hits / tutmayan @group.Misses</div>
                    <div class="card-body">
                        @if (group.Hits + group.Misses == 0)
                        {
                            <p class="text-secondary mb-0">Bu aralıkta kapanmış plan yok.</p>
                        }
                        else
                        {
                            <div class="d-flex text-secondary small mb-1"><span class="rate-label">Kalem</span><span class="rate-value">Tutan</span><span class="rate-value">Tutmayan</span></div>
                            @foreach (var part in group.Parts)
                            {
                                <div class="d-flex mb-1"><span class="rate-label">@part.Label</span><span class="rate-value">@part.Hit</span><span class="rate-value">@part.Miss</span></div>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card border-secondary-subtle">
        <div class="table-panel">
            <table class="table table-hover align-middle mb-0 data-table">
                <thead>
                    <tr>
                        <th>Saat (TSİ)</th>
                        <th>Sembol</th>
                        <th class="num">Skor</th>
                        <th class="num">Trend</th>
                        <th class="num">RSI</th>
                        <th class="num">Hacim</th>
                        <th class="num">Destek</th>
                        <th class="num">Açık işlem</th>
                        <th class="num">BTC</th>
                        <th class="num">Giriş</th>
                        <th>Stop</th>
                        <th>Temkinli</th>
                        <th>Dengeli</th>
                        <th>Geniş</th>
                    </tr>
                </thead>
                <tbody>
                    @if (VisibleRows.Count == 0)
                    {
                        <tr class="empty-row"><td colspan="14" class="text-secondary">Bu aralıkta gösterilecek plan yok.</td></tr>
                    }
                    @foreach (var row in VisibleRows)
                    {
                        <tr>
                            <td class="text-nowrap">@DisplayText.TurkeyTime(row.CreatedAt)</td>
                            <td><a class="fw-semibold" href="/signals/@row.Id">@row.Symbol</a> <span class="badge text-bg-secondary ms-1">@(row.CoinType == CoinType.Stock ? "Hisse" : "Kripto")</span></td>
                            <td class="num">@row.TotalScore.ToString("0")</td>
                            <td class="num">@Part(row, "trend")</td>
                            <td class="num">@Part(row, "rsi")</td>
                            <td class="num">@Part(row, "volume")</td>
                            <td class="num">@Part(row, "support")</td>
                            <td class="num">@Part(row, "oi")</td>
                            <td class="num">@Part(row, "btc_rs")</td>
                            <td class="num font-monospace">@FormatPrice(row.EntryPrice)</td>
                            <td><TargetCell Price="@row.StopPrice" Minutes="@row.StopMinutes" ClosedAt="@row.TargetsClosedAt" /></td>
                            <td><TargetCell Price="@row.CautiousExit" Minutes="@row.CautiousMinutes" ClosedAt="@row.TargetsClosedAt" /></td>
                            <td><TargetCell Price="@row.BalancedExit" Minutes="@row.BalancedMinutes" ClosedAt="@row.TargetsClosedAt" /></td>
                            <td><TargetCell Price="@row.WideExit" Minutes="@row.WideMinutes" ClosedAt="@row.TargetsClosedAt" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private static readonly (string Key, string Label)[] CryptoParts =
    [
        ("trend", "Trend"),
        ("rsi", "RSI"),
        ("volume", "Hacim"),
        ("support", "Destek"),
        ("oi", "Açık işlem"),
        ("btc_rs", "Bitcoin'e göre"),
        ("pattern_bonus", "Mum")
    ];

    private static readonly (string Key, string Label)[] StockParts =
    [
        ("trend", "Trend"),
        ("rsi", "RSI"),
        ("volume", "Hacim"),
        ("support", "Destek"),
        ("pattern_bonus", "Mum")
    ];

    private DateTime? fromDate;
    private DateTime? toDate;
    private string resultFilter = "all";
    private IReadOnlyList<ExitTargetRow> rows = [];

    private IReadOnlyList<ExitTargetRow> VisibleRows => resultFilter switch
    {
        "hit" => rows.Where(x => x.CautiousMinutes is not null).ToList(),
        "miss" => rows.Where(x => x.TargetsClosedAt is not null && x.TargetsCloseReason != ExitTargetEvaluator.BtcBreakReason && x.CautiousMinutes is null).ToList(),
        _ => rows
    };

    private int closedCount => rows.Count(x => x.TargetsClosedAt is not null);
    private int btcBrokenCount => rows.Count(x => x.TargetsCloseReason == ExitTargetEvaluator.BtcBreakReason);
    private int scoredCount => closedCount - btcBrokenCount;
    private decimal cautiousRate => HitRate(rows.Count(x => x.TargetsClosedAt is not null && x.TargetsCloseReason != ExitTargetEvaluator.BtcBreakReason && x.CautiousMinutes is not null));
    private decimal balancedRate => HitRate(rows.Count(x => x.TargetsClosedAt is not null && x.TargetsCloseReason != ExitTargetEvaluator.BtcBreakReason && x.BalancedMinutes is not null));
    private decimal wideRate => HitRate(rows.Count(x => x.TargetsClosedAt is not null && x.TargetsCloseReason != ExitTargetEvaluator.BtcBreakReason && x.WideMinutes is not null));

    protected override async Task OnInitializedAsync()
    {
        if (Session.IsAuthenticated)
        {
            await Load();
        }
    }

    private async Task Load()
    {
        rows = await DataService.GetExitTargetsAsync(ToUtcStart(fromDate), ToUtcEnd(toDate));
    }

    private decimal HitRate(int hits)
    {
        if (scoredCount == 0)
        {
            return 0m;
        }

        return Math.Round((decimal)hits * 100m / scoredCount, 2);
    }

    private static DateTimeOffset? ToUtcStart(DateTime? date)
    {
        if (!date.HasValue)
        {
            return null;
        }

        return new DateTimeOffset(DateTime.SpecifyKind(date.Value.Date, DateTimeKind.Utc));
    }

    private static DateTimeOffset? ToUtcEnd(DateTime? date)
    {
        if (!date.HasValue)
        {
            return null;
        }

        return new DateTimeOffset(DateTime.SpecifyKind(date.Value.Date.AddDays(1).AddTicks(-1), DateTimeKind.Utc));
    }

    private IReadOnlyList<ScoreGroup> ScoreComparisons()
    {
        return
        [
            Compare("Kripto", CoinType.Crypto, CryptoParts),
            Compare("Hisse", CoinType.Stock, StockParts)
        ];
    }

    private ScoreGroup Compare(string title, CoinType coinType, (string Key, string Label)[] parts)
    {
        var closed = rows.Where(x => x.CoinType == coinType && x.TargetsClosedAt is not null && x.TargetsCloseReason != ExitTargetEvaluator.BtcBreakReason).ToList();
        var hits = closed.Where(x => x.CautiousMinutes is not null).ToList();
        var misses = closed.Where(x => x.CautiousMinutes is null).ToList();
        return new ScoreGroup
        {
            Title = title,
            Hits = hits.Count,
            Misses = misses.Count,
            Parts = parts.Select(part => new ScorePart
            {
                Label = part.Label,
                Hit = Average(hits, part.Key),
                Miss = Average(misses, part.Key)
            }).ToList()
        };
    }

    private static string Average(IReadOnlyList<ExitTargetRow> source, string key)
    {
        var values = source
            .Select(row => row.Breakdown.TryGetValue(key, out var value) ? value : (int?)null)
            .Where(value => value.HasValue)
            .Select(value => value!.Value)
            .ToList();
        return values.Count == 0 ? "—" : Math.Round((decimal)values.Average(), 1).ToString("0.#");
    }

    private static string Part(ExitTargetRow row, string key)
    {
        return row.Breakdown.TryGetValue(key, out var value) ? value.ToString() : "—";
    }

    private sealed class ScoreGroup
    {
        public string Title { get; init; } = string.Empty;
        public int Hits { get; init; }
        public int Misses { get; init; }
        public List<ScorePart> Parts { get; init; } = [];
    }

    private sealed class ScorePart
    {
        public string Label { get; init; } = string.Empty;
        public string Hit { get; init; } = "—";
        public string Miss { get; init; } = "—";
    }

    private static string FormatPrice(decimal? value)
    {
        return value?.ToString("0.########") ?? "—";
    }
}
