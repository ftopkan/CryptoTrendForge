@page "/performance"
@inject DashboardDataService DataService
@inject DashboardSession Session

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Performance</h1>
</div>

@if (!Session.IsAuthenticated)
{
    <div class="alert alert-secondary">You must log in first. <a href="/login">Go to login</a></div>
}
else if (snapshot is null)
{
    <p class="text-secondary">Loading...</p>
}
else
{
    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-3"><div class="card border-secondary-subtle h-100"><div class="card-body"><div class="text-secondary small">Signals at 1h</div><div class="stat-value">@snapshot.TotalSignalsAt1H</div></div></div></div>
        <div class="col-6 col-lg-3"><div class="card border-secondary-subtle h-100"><div class="card-body"><div class="text-secondary small">Success rate</div><div class="stat-value">@snapshot.OverallSuccessRatePct%</div></div></div></div>
        <div class="col-6 col-lg-3"><div class="card border-secondary-subtle h-100"><div class="card-body"><div class="text-secondary small">Avg change 1h</div><div class="stat-value @(snapshot.AvgChange1HPct >= 0 ? "text-success" : "text-danger")">@snapshot.AvgChange1HPct.ToString("+0.##;-0.##;0")%</div></div></div></div>
        <div class="col-6 col-lg-3"><div class="card border-secondary-subtle h-100"><div class="card-body"><div class="text-secondary small">Avg change 4h</div><div class="stat-value @(snapshot.AvgChange4HPct >= 0 ? "text-success" : "text-danger")">@snapshot.AvgChange4HPct.ToString("+0.##;-0.##;0")%</div></div></div></div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <div class="card border-secondary-subtle h-100">
                <div class="card-header">Exit target hit rate</div>
                <div class="card-body">
                    <p class="text-secondary small">Closed plans: @snapshot.ExitTargets.ClosedSignals</p>
                    <RateBar Label="Cautious" Percent="@snapshot.ExitTargets.CautiousHitRatePct" Value="@($"{snapshot.ExitTargets.CautiousHitRatePct}%")" />
                    <RateBar Label="Balanced" Percent="@snapshot.ExitTargets.BalancedHitRatePct" Value="@($"{snapshot.ExitTargets.BalancedHitRatePct}%")" />
                    <RateBar Label="Wide" Percent="@snapshot.ExitTargets.WideHitRatePct" Value="@($"{snapshot.ExitTargets.WideHitRatePct}%")" />
                    <RateBar Label="With pattern" Percent="@snapshot.PatternWithSuccessRate" Value="@($"{snapshot.PatternWithSuccessRate}%")" />
                    <RateBar Label="No pattern" Percent="@snapshot.PatternWithoutSuccessRate" Value="@($"{snapshot.PatternWithoutSuccessRate}%")" />
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-secondary-subtle h-100">
                <div class="card-header">By regime</div>
                <div class="card-body">
                    @if (snapshot.RegimeBuckets.Count == 0)
                    {
                        <p class="text-secondary mb-0">No closed 1h outcomes yet.</p>
                    }
                    @foreach (var bucket in snapshot.RegimeBuckets)
                    {
                        <RateBar Label="@bucket.Key" Percent="@bucket.SuccessRatePct" Value="@($"{bucket.SuccessRatePct}% · {bucket.Total}")" />
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card border-secondary-subtle">
        <div class="card-header">By coin</div>
        <div class="card-body">
            @if (snapshot.CoinBuckets.Count == 0)
            {
                <p class="text-secondary mb-0">No closed 1h outcomes yet.</p>
            }
            @foreach (var bucket in snapshot.CoinBuckets)
            {
                <RateBar Label="@bucket.Key" Percent="@bucket.SuccessRatePct" Value="@($"{bucket.SuccessRatePct}% · {bucket.Total}")" />
            }
        </div>
    </div>
}

@code {
    private PerformanceSnapshot? snapshot;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            return;
        }

        snapshot = await DataService.GetPerformanceAsync();
    }
}
