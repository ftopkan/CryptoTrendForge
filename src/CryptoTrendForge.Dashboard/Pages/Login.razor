@page "/login"
@inject DashboardSession Session
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Options.IOptions<CryptoTrendForge.Dashboard.Configuration.DashboardAuthOptions> AuthOptions

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <div class="card border-secondary-subtle shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Dashboard login</h1>
                <div class="mb-3">
                    <label class="form-label">Username</label>
                    <input class="form-control" @bind="username" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input class="form-control" type="password" @bind="password" />
                </div>
                <button class="btn btn-primary w-100" @onclick="SignIn">Sign in</button>
                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <div class="alert alert-danger mt-3 mb-0">@error</div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string username = string.Empty;
    private string password = string.Empty;
    private string? error;

    private void SignIn()
    {
        var options = AuthOptions.Value;
        if (username == options.Username && password == options.Password)
        {
            Session.SignIn();
            Navigation.NavigateTo("/signals");
            return;
        }

        error = "Invalid credentials.";
    }
}
