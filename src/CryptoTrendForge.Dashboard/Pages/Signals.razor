@page "/signals"
@inject DashboardDataService DataService
@inject DashboardSession Session

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Signals</h1>
</div>

@if (!Session.IsAuthenticated)
{
    <div class="alert alert-secondary">You must log in first. <a href="/login">Go to login</a></div>
}
else
{
    <div class="card border-secondary-subtle mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Symbol</label>
                    <input class="form-control" placeholder="XRPUSDT" @bind="filter.Symbol" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Min score</label>
                    <input class="form-control" type="number" @bind="minScoreInput" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Status</label>
                    <select class="form-select" @bind="statusText">
                        <option value="">All</option>
                        @foreach (var status in Enum.GetValues<SignalStatus>())
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Asset</label>
                    <select class="form-select" @bind="coinTypeText">
                        <option value="">All</option>
                        <option value="@CoinType.Crypto">Crypto</option>
                        <option value="@CoinType.Stock">Stock</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Regime</label>
                    <select class="form-select" @bind="regimeText">
                        <option value="">All</option>
                        @foreach (var regime in Enum.GetValues<MarketRegime>())
                        {
                            <option value="@regime">@regime</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="patternOnly" @bind="filter.PatternBonusOnly" />
                        <label class="form-check-label" for="patternOnly">Pattern bonus</label>
                    </div>
                </div>
                <div class="col-md-1">
                    <button class="btn btn-primary w-100" @onclick="Load">Filter</button>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-secondary-subtle">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Symbol</th>
                        <th>Total</th>
                        <th>Base</th>
                        <th>Pattern</th>
                        <th>Status</th>
                        <th>Regime</th>
                        <th>Type</th>
                        <th>Time (UTC)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (signals.Count == 0)
                    {
                        <tr><td colspan="9" class="text-secondary">No signals match this filter.</td></tr>
                    }
                    @foreach (var item in signals)
                    {
                        <tr>
                            <td><a href="/signals/@item.Id">@item.Id</a></td>
                            <td class="fw-semibold">@item.Symbol <span class="badge text-bg-secondary">@(item.CoinType == CoinType.Stock ? "Hisse" : "Kripto")</span></td>
                            <td>@item.TotalScore</td>
                            <td>@item.BaseScore</td>
                            <td>@item.PatternBonus</td>
                            <td><span class="badge text-bg-dark">@item.Status</span></td>
                            <td>@if (item.CoinType == CoinType.Stock) { <span class="text-secondary">—</span> } else { <RegimeIndicator Regime="@item.Regime" /> }</td>
                            <td>@item.SignalType</td>
                            <td class="text-nowrap">@item.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private readonly SignalFilter filter = new();
    private decimal? minScoreInput;
    private string statusText = string.Empty;
    private string regimeText = string.Empty;
    private string coinTypeText = string.Empty;
    private IReadOnlyList<SignalListItem> signals = [];

    protected override async Task OnInitializedAsync()
    {
        if (Session.IsAuthenticated)
        {
            await Load();
        }
    }

    private async Task Load()
    {
        filter.MinScore = minScoreInput;
        filter.Status = Enum.TryParse<SignalStatus>(statusText, out var status) ? status : null;
        filter.Regime = Enum.TryParse<MarketRegime>(regimeText, out var regime) ? regime : null;
        filter.CoinType = Enum.TryParse<CoinType>(coinTypeText, out var coinType) ? coinType : null;
        signals = await DataService.GetSignalsAsync(filter);
    }
}
