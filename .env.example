# Plesk / production — set these as environment variables (do not commit real values)

ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production
Database__Provider=SqlServer
ConnectionStrings__DefaultConnection=Server=localhost;Database=trendforge_;User Id=trendforge;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=True;

# Dashboard
DashboardAuth__Username=admin
DashboardAuth__Password=YOUR_DASHBOARD_PASSWORD

# Worker
Telegram__BotToken=YOUR_BOT_TOKEN
Telegram__ChatId=YOUR_CHAT_ID
